    "react-markdown": "^9.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.1",
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.10.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
